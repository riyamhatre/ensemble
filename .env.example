# Copy to .env and fill in. Never commit .env.
# Wikimedia Enterprise account (free): https://enterprise.wikimedia.com/docs/#getting-api-keys
WIKIMEDIA_USERNAME=
WIKIMEDIA_PASSWORD=
# Only needed to rerun the ingest scripts: an email or project URL for the User-Agent
BROADWAY_CONTACT=
# Optional, only for nyt.py: https://developer.nytimes.com
NYT_API_KEY=